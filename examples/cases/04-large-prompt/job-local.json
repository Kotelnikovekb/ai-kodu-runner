{
  "api_version": "ai-kodu-runner.dev/v1alpha1",
  "id": "case-large-prompt-local",
  "attempt": 1,
  "executor": "docker",
  "image": "alpine:3.20",
  "command": [
    "sh",
    "-lc",
    "set -eu; test -s /workspace/prompt.md; wc -c /workspace/prompt.md > prompt-size.txt; grep -q 'Русский на 100' /workspace/prompt.md; printf 'large prompt transferred successfully\n' > prompt-check.txt; cat prompt-size.txt"
  ],
  "working_directory": "/workspace",
  "workspace": {
    "kind": "local",
    "path": "./examples"
  },
  "environment_from_runner": [],
  "secrets": [],
  "resources": {
    "cpu": 1.0,
    "memory_mb": 256,
    "pids": 64,
    "timeout_seconds": 60
  },
  "network": {
    "mode": "none"
  },
  "artifacts": [
    "prompt-size.txt",
    "prompt-check.txt"
  ]
}
