{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "lsp": true,
  "model": "freemodel/auto",
  "provider": {
    "freemodel": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeModel Direct",
      "options": {
        "baseURL": "https://vip-sg.freemodel.dev/v1",
        "apiKey": "{env:FREEMODEL_API_KEY}"
      },
      "models": {
        "auto": {
          "name": "FreeModel Auto",
          "limit": {
            "context": 128000,
            "output": 32000
          }
        }
      }
    },
    "ai-kodu-runner": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI Kodu Runner",
      "options": {
        "baseURL": "{env:AI_KODU_RUNNER_BASE_URL}",
        "apiKey": "{env:AI_KODU_RUNNER_API_KEY}"
      },
      "models": {
        "coder": {
          "id": "combo/coder",
          "name": "AI Kodu Runner Coder"
        }
      }
    }
  },
    "model": "ai-kodu-runner/coder",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:AI_KODU_RUNNER_MCP_KEY}"
      },
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}
