{
  "api_version": "omniroute.dev/v1alpha1",
  "id": "flutter-local-opencode",
  "attempt": 1,
  "executor": "docker",
  "image": "flutter-opencode:local",
  "command": [
    "opencode", "run", "--format", "json",
    "Implement the attached task, use the project skills and Context7 when needed, run the checks, and do not commit or push.",
    "-f", "/workspace/prompt.md"
  ],
  "working_directory": "/workspace",
  "workspace": {
    "kind": "local",
    "path": "./examples/flutter-app"
  },
  "environment_from_runner": [
    "OMNIROUTE_MCP_KEY",
    "OMNIROUTE_API_KEY",
    "OMNIROUTE_BASE_URL",
    "FREEMODEL_API_KEY"
  ],
  "secrets": [],
  "resources": {
    "cpu": 4.0,
    "memory_mb": 8192,
    "pids": 512,
    "timeout_seconds": 3600
  },
  "network": {
    "mode": "bridge"
  },
  "writable_rootfs": true,
  "artifacts": ["lib/**", "test/**", "assets/**", "web/**", "pubspec.yaml", "pubspec.lock", "analysis_options.yaml", "README.md", "AGENTS.md"]
}
